MYSQL_DATABASE=zentao
MYSQL_USER=zentao
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
ZENTAO_BIND=127.0.0.1
ZENTAO_PORT=8080
# Redis 序列化器可选 php 或 igbinary，默认 php。
# ZT_REDIS_SERIALIZER=igbinary
# 启用 Redis 前运行 openssl rand -hex 24，将结果填入此项。
# ZT_REDIS_PASSWORD=
# 使用 compose.persistence.yaml 时设置为 Docker 主机上的绝对路径。
# ZENTAO_DATA_DIR=/data/zentao
# 保存带令牌的供应方或启用 GitLab 回调时，叠加 compose.integrations.yaml。
# 填写宿主机密钥文件的绝对路径。升级和恢复时沿用原密钥。
# ZENTAO_INTEGRATION_KEY_PATH=/etc/zentao/secrets/integration.key

# GitLab 回调使用受信任的 HTTPS 站点地址，含实际子路径。
# ZT_GITLAB_CALLBACK_BASE_URL=https://zentao.example.com
